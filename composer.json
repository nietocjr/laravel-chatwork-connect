{
  "name": "nietocjr/laravel-chatwork-connect",
  "description": "Seamless integration of Chatwork API with Laravel for easy messaging.",
  "keywords": [
    "nietocjr",
    "laravel",
    "chatwork",
    "laravel-chatwork-connect"
  ],
  "homepage": "https://github.com/nietocjr/laravel-chatwork-connect",
  "license": "MIT",
  "authors": [
    {
      "name": "Nieto Jose",
      "email": "my.harddisk496@slmail.me",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3",
    "spatie/laravel-package-tools": "^1.93",
    "illuminate/contracts": "^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^11.0",
    "nesbot/carbon": "^3.8.4",
    "pestphp/pest": "^4.4",
    "pestphp/pest-plugin-laravel": "^4.1",
    "laravel/pint": "^1.18",
    "nunomaduro/collision": "^8.9",
    "larastan/larastan": "^3.9",
    "pestphp/pest-plugin-arch": "^4.0",
    "phpstan/extension-installer": "^1.3",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-phpunit": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "nietocjr\\LaravelChatworkConnect\\": "src/",
      "nietocjr\\LaravelChatworkConnect\\Database\\Factories\\": "database/factories/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "nietocjr\\LaravelChatworkConnect\\Tests\\": "tests/",
      "Workbench\\App\\": "workbench/app/"
    }
  },
  "scripts": {
    "post-autoload-dump": "@composer run prepare",
    "clear": "@php vendor/bin/testbench package:purge-laravel-chatwork-connect --ansi",
    "prepare": "@php vendor/bin/testbench package:discover --ansi",
    "build": [
      "@composer run prepare",
      "@php vendor/bin/testbench workbench:build --ansi"
    ],
    "start": [
      "Composer\\Config::disableProcessTimeout",
      "@composer run build",
      "@php vendor/bin/testbench serve"
    ],
    "analyse": "vendor/bin/phpstan analyse",
    "test": "vendor/bin/pest",
    "test-coverage": "vendor/bin/pest --coverage",
    "format": "vendor/bin/pint"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "phpstan/extension-installer": true
    }
  },
  "conflict": {
    "laravel/framework": "<13.0"
  },
  "extra": {
    "laravel": {
      "providers": [
        "nietocjr\\LaravelChatworkConnect\\LaravelChatworkConnectServiceProvider"
      ],
      "aliases": {
        "LaravelChatworkConnect": "nietocjr\\LaravelChatworkConnect\\Facades\\LaravelChatworkConnect"
      }
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
